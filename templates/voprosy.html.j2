{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}

{% block content %}
<section class="sec pgh" style="padding-bottom:calc(var(--sec) * .5)">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i>Вопросы</nav>
    <p class="kick">Частые вопросы</p>
    <h1>Что спрашивают до начала работ и до покупки материалов</h1>
    <p>Отвечаем на три главных вопроса: сколько стоит, как проходит работа и сколько она длится. Плюс то, что чаще всего спрашивают в отделе продаж.</p>
  </div>
</section>

<section class="sec sec--lt" style="padding-top:calc(var(--sec) * .6)">
  <div class="wrap">
    <div class="faq">
      {% for f in faq_all %}
      <details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><div class="faq__a">{{ f.a }}</div></details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--alt">
  <div class="wrap">
    <div class="head"><p class="kick">Как проходит работа</p><h2>Пять шагов от звонка до подписанного акта</h2></div>
    <div class="stp">
      {% for st in site.process %}
      <div><b>{{ '%02d' % st.step }}</b><h3>{{ st.title }}</h3><p>{{ st.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Не нашли ответ</p>
      <h2 style="margin-bottom:.7rem">Спросите напрямую</h2>
      <p class="measure-s mut">Ремонт и строительство: <a href="tel:{{ site.phones.works[0].tel }}" class="brass">{{ site.phones.works[0].display }}</a>, {{ site.phones.works[0].name }}.<br>
      Материалы: <a href="tel:{{ site.phones.sales[0].tel }}" class="brass">{{ site.phones.sales[0].display }}</a>, {{ site.phones.sales[0].name }}.</p>
    </div>
    {{ form_block('v', 'Задать вопрос', 'Оставьте телефон и вопрос, менеджер перезвонит в рабочее время и ответит.', 'Отправить вопрос', 'Страница вопросов') }}
  </div>
</section>
{% endblock %}
