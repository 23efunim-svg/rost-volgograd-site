{% macro form_block(id, title, subtitle, button, source='') %}
<form class="frm" method="post" action="/api/lead.php" data-lead novalidate>
  <h3>{{ title }}</h3>
  <p>{{ subtitle }}</p>

  <input type="hidden" name="source" value="{{ source or title }}">
  <input type="hidden" name="page" value="" data-page>
  <input type="hidden" name="ts" value="" data-ts>
  <div class="hp" aria-hidden="true"><label>Не заполняйте это поле<input type="text" name="company" tabindex="-1" autocomplete="off"></label></div>

  <div class="fld">
    <label for="{{ id }}-n">Как к вам обращаться</label>
    <input id="{{ id }}-n" name="name" type="text" autocomplete="name" placeholder="Имя">
  </div>

  <div class="fld" data-fld>
    <label for="{{ id }}-p">Телефон *</label>
    <input id="{{ id }}-p" name="phone" type="tel" inputmode="tel" autocomplete="tel"
           placeholder="+7 (___) ___-__-__" required aria-required="true">
    <span class="fld__e">Проверьте номер: нужно 11 цифр, начиная с 7 или 8</span>
  </div>

  <div class="fld">
    <label for="{{ id }}-t">Что нужно сделать, не обязательно</label>
    <textarea id="{{ id }}-t" name="note" rows="2" placeholder="Например: двушка на вторичке, ремонт под ключ"></textarea>
  </div>

  <div class="fld">
    <label>Как удобнее связаться</label>
    <div class="opt">
      <label><input type="radio" name="channel" value="Звонок" checked><span>Звонок</span></label>
      <label><input type="radio" name="channel" value="МАКС"><span>МАКС</span></label>
      <label><input type="radio" name="channel" value="ВКонтакте"><span>ВКонтакте</span></label>
    </div>
  </div>

  <label class="cns">
    <input type="checkbox" name="consent" value="1" required>
    <span>Даю <a href="/soglasie/" target="_blank">согласие на обработку персональных данных</a> и ознакомлен с <a href="/politika/" target="_blank">политикой</a></span>
  </label>

  <button class="btn btn--fill btn--w" type="submit"><span>{{ button }}</span></button>
  <div class="msg" data-msg role="status"></div>
</form>
{% endmacro %}
