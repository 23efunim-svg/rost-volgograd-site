{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}
{% from "_icons.html.j2" import ic %}

{% block content %}
<section class="sec pgh" style="padding-bottom:calc(var(--sec) * .6)">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i>Услуги</nav>
    <p class="kick">Волгоград и область</p>
    <h1>Все строительные и ремонтные работы в одном подрядчике</h1>
    <p>От косметики в однокомнатной до дома с нуля вместе с забором и брусчаткой. Материалы берём со своей базы на Циолковского, поэтому в смете видно и работу, и материал.</p>
  </div>
</section>

<section class="sec sec--lt" style="padding-top:calc(var(--sec) * .7)">
  <div class="wrap">
    <div class="svc">
      {% for s in services.services %}
      <a href="/uslugi/{{ s.slug }}/">
        <span class="svc__n">{{ '%02d' % loop.index }}</span>
        <span class="svc__ic">{{ ic(svc_icons[s.slug]) }}</span>
        <span class="svc__t">{{ s.nav }}<s>{{ s.works[:4] | join(', ') | lower }}</s></span>
        <span class="svc__p">{% if s.price_ref == 'remont' %}от 7 000 ₽/м²{% else %}цена после замера{% endif %}</span>
      </a>
      {% endfor %}
    </div>

    <div class="head" style="margin-top:calc(var(--sec) * .8)">
      <p class="kick">Цены на ремонт</p>
      <h2>Три уровня отделки, ставка за квадратный метр</h2>
      <p>{{ services.price_tables.remont.note }}</p>
    </div>
    <div class="pr-wrap">
      <table class="pr">
        <thead><tr><th scope="col">Уровень</th><th scope="col">Косметический</th><th scope="col">Новостройка</th><th scope="col">Вторичное жильё</th></tr></thead>
        <tbody>
          {% for lv in services.price_tables.remont.levels %}
          {% set rows = {} %}{% for r in lv.rows %}{% set _ = rows.update({r.label: r.price}) %}{% endfor %}
          <tr>
            <th scope="row">{{ lv.name }}<span class="pr__lvl">{{ lv.desc }}</span></th>
            <td{% if 'Мелкий косметический ремонт' not in rows %} class="na"{% endif %}>{% if 'Мелкий косметический ремонт' in rows %}от {{ rows['Мелкий косметический ремонт'] | money }} ₽{% else %}по запросу{% endif %}</td>
            <td>от {{ rows['Новостройка'] | money }} ₽</td>
            <td>от {{ rows['Вторичное жильё'] | money }} ₽</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Следующий шаг</p>
      <h2 style="margin-bottom:.7rem">Приедем, посмотрим объект и посчитаем</h2>
      <p class="measure-s mut" style="margin-bottom:1.4rem">Консультация бесплатная. На замере уточним состав работ и покажем, из чего складывается сумма.</p>
      <ul class="chk">{% for g in site.guarantees %}<li>{{ g }}</li>{% endfor %}</ul>
    </div>
    {{ form_block('u', 'Вызвать замерщика', 'Оставьте телефон, менеджер перезвонит в рабочее время и договорится об удобном времени.', 'Вызвать замерщика', 'Страница услуг') }}
  </div>
</section>
{% endblock %}
