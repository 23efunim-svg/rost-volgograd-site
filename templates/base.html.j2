{% from "_icons.html.j2" import ic %}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page.title_tag }}</title>
<meta name="description" content="{{ page.description }}">
<link rel="canonical" href="https://{{ site.brand.domain }}{{ page.url }}">
<meta name="robots" content="index, follow">

<meta property="og:type" content="website">
<meta property="og:site_name" content="РОСТ · РЕМОПТСТРОЙТОРГ">
<meta property="og:title" content="{{ page.title_tag }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:url" content="https://{{ site.brand.domain }}{{ page.url }}">
<meta property="og:image" content="https://{{ site.brand.domain }}/assets/img/og-cover.jpg">
<meta property="og:locale" content="ru_RU">

<link rel="icon" href="/assets/logo/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/logo/apple-touch-icon.png">
<link rel="preload" href="/assets/fonts/onest-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/forum-400-cyrillic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/css/fonts.css?v={{ today }}">
<link rel="stylesheet" href="/assets/css/base.css?v={{ today }}">
<link rel="stylesheet" href="/assets/css/blocks.css?v={{ today }}">
{% block head_extra %}{% endblock %}

<script>
/* тема применяется до первой отрисовки, иначе на светлой теме мелькает тёмный фон */
(function(){try{var t=localStorage.getItem('rost_theme');
if(!t&&window.matchMedia&&matchMedia('(prefers-color-scheme: light)').matches)t='light';
if(t==='light')document.documentElement.setAttribute('data-theme','light');}catch(e){}})();
</script>

<script type="application/ld+json">{{ page.jsonld | safe }}</script>
</head>
<body>

<header class="hdr">
  <span class="hdr__prog" data-prog aria-hidden="true"></span>
  <div class="wrap hdr__row">
    <a class="lg" href="/">
      <img src="/assets/logo/mark-brass.svg" alt="РОСТ РЕМОПТСТРОЙТОРГ" width="24" height="28">
      <span><b>РОСТ</b><s>ремоптстройторг</s></span>
    </a>
    <nav class="nav" aria-label="Основная навигация">
      {%- for it in nav %}
      <a href="{{ it.url }}"{% if page.url == it.url or (it.url != '/' and page.url.startswith(it.url)) %} aria-current="page"{% endif %}>{{ it.label }}</a>
      {%- endfor %}
    </nav>
    <div class="hdr__end">
      <a class="tel" href="tel:{{ site.phones.primary.tel }}">{{ site.phones.primary.display }}<s>Пн–Пт 9:00–18:00</s></a>
      <button class="btn btn--fill" type="button" data-modal><span>Вызвать замерщика</span></button>
      <button class="thm" type="button" data-theme-toggle aria-label="Переключить тему">
        {{ ic('moon', 'i-moon') }}{{ ic('sun', 'i-sun') }}
      </button>
      <button class="brg" type="button" aria-label="Меню" aria-expanded="false" data-brg><i></i><i></i><i></i></button>
    </div>
  </div>
  <div class="mnav" data-mnav>
    <div class="wrap">
      {%- for it in nav %}<a href="{{ it.url }}">{{ it.label }}</a>{% endfor %}
      <div class="mnav__b">
        <a class="btn btn--gh btn--w" href="tel:{{ site.phones.primary.tel }}"><span>Позвонить {{ site.phones.primary.display }}</span></a>
        <button class="btn btn--fill btn--w" type="button" data-modal><span>Вызвать замерщика</span></button>
      </div>
    </div>
  </div>
</header>

<main>
{% block content %}{% endblock %}
</main>

<div class="mbar">
  <a class="btn btn--gh" href="tel:{{ site.phones.primary.tel }}"><span>Позвонить</span></a>
  <button class="btn btn--fill" type="button" data-modal><span>Вызвать замерщика</span></button>
</div>

<button class="up" type="button" data-up aria-label="Наверх">{{ ic('up') }}</button>

<div class="lb" data-lb role="dialog" aria-modal="true" aria-label="Просмотр фотографии">
  <button class="lb__x" type="button" data-lb-x aria-label="Закрыть">×</button>
  <img data-lb-img alt="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==">
  <p class="lb__n" data-lb-num></p>
</div>

{% include "_footer.html.j2" %}
{% include "_modal.html.j2" %}

{% if demo %}<script>window.__demo = true;</script>{% endif %}
<script src="/assets/js/app.js?v={{ today }}" defer></script>
</body>
</html>
