{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}

{% block content %}
<section class="sec pgh" style="padding-bottom:calc(var(--sec) * .5)">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i><a href="/raboty/">Работы</a><i>/</i>{{ obj.title }}</nav>
    <p class="kick">{{ meta.type }}</p>
    <h1>{{ obj.title }}</h1>
    <p>{{ meta.lead }}</p>

    {% if meta.area or meta.term or meta.price %}
    <dl class="facts" style="margin-top:1.3rem;max-width:720px">
      {% if meta.area %}<div><dt>Площадь</dt><dd>{{ meta.area }}</dd></div>{% endif %}
      {% if meta.term %}<div><dt>Срок</dt><dd>{{ meta.term }}</dd></div>{% endif %}
      {% if meta.price %}<div><dt>Стоимость работ</dt><dd>{{ meta.price }}</dd></div>{% endif %}
      <div><dt>Фотографий</dt><dd>{{ obj.photos | length }}</dd></div>
    </dl>
    {% endif %}
  </div>
</section>

<section class="sec" style="padding-top:calc(var(--sec) * .5)">
  <div class="wrap">
    <div class="grid" style="grid-template-columns:.85fr 1.15fr;gap:clamp(1.4rem,1rem+2.4vw,3rem);align-items:start;margin-bottom:1.6rem">
      <div>
        <p class="kick">Что делали</p>
        <ul class="chk">{% for w in meta.works %}<li>{{ w }}</li>{% endfor %}</ul>
      </div>
      <div>
        <p class="kick">Материалы</p>
        <p class="mut" style="font-size:var(--sm);margin-bottom:1rem">Материалы на этот объект шли со своей базы. Так объём считается сразу под работу, а бригада не ждёт поставку.</p>
        <a class="btn btn--gh" href="/stroymaterialy/"><span>Каталог материалов</span></a>
      </div>
    </div>

    <div class="gal">
      {% for p in obj.photos %}
      <figure>
        <img src="/assets/photo/objects/{{ slug }}/{{ p.name }}{% if loop.index > 3 %}-thumb{% endif %}.webp"
             alt="{{ obj.title }}, фото {{ loop.index }}"
             loading="{{ 'eager' if loop.index <= 2 else 'lazy' }}"
             width="{{ p.w }}" height="{{ p.h }}">
      </figure>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--lt">
  <div class="wrap">
    <div class="head"><p class="kick">Другие объекты</p><h2>Ещё работы в Волгограде и области</h2></div>
    <div class="tags">{% for s, o in objects.items() if s != slug %}<a href="/raboty/{{ s }}/">{{ o.title }}</a>{% endfor %}</div>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Следующий шаг</p>
      <h2 style="margin-bottom:.7rem">Посчитаем такой же объём по вашему объекту</h2>
      <p class="measure-s mut">Скажите площадь и что нужно сделать. Менеджер назовёт вилку по телефону и договорится о замере.</p>
    </div>
    {{ form_block('o', 'Вызвать замерщика', 'Оставьте телефон, перезвоним в рабочее время и уточним детали объекта.', 'Вызвать замерщика', 'Объект: ' + obj.title) }}
  </div>
</section>
{% endblock %}
