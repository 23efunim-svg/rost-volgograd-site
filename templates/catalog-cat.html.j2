{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}

{% block content %}
<section class="sec pgh" style="padding-bottom:calc(var(--sec) * .55)">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i><a href="/stroymaterialy/">Стройматериалы</a><i>/</i>{{ cat.name }}</nav>
    <p class="kick">Волгоград, база на Циолковского</p>
    <h1>{{ cat.name }}</h1>
    <p>{{ cat.lead }}</p>
    <div class="hero__act" style="margin:1.3rem 0 0">
      <button class="btn btn--fill" type="button" data-modal><span>Узнать цену и наличие</span></button>
      <a class="btn btn--gh" href="tel:{{ site.phones.sales[0].tel }}"><span>{{ site.phones.sales[0].display }}</span></a>
    </div>
  </div>
</section>

<section class="sec sec--lt">
  <div class="wrap">
    <div class="grid" style="grid-template-columns:1.3fr .7fr;gap:clamp(1.4rem,1rem+2.4vw,3rem);align-items:start">
      <div>
        <div class="head"><p class="kick">Что есть в этой группе</p><h2>Позиции, которые подбираем и поставляем</h2></div>
        <ul class="chk chk--2">{% for i in cat['items'] %}<li>{{ i }}</li>{% endfor %}</ul>

        <h3 style="margin:1.8rem 0 .5rem">Что сказать менеджеру, чтобы посчитать точно</h3>
        <p class="mut" style="font-size:var(--sm)">{{ cat.params }}. Если параметров под рукой нет, достаточно размеров объекта или фотографии проекта: посчитаем сами.</p>

        <h3 style="margin:1.4rem 0 .5rem">Единицы, в которых считаем</h3>
        <p class="mut" style="font-size:var(--sm)">{{ cat.units }}</p>
      </div>

      <aside>
        <div class="frm" style="position:sticky;top:calc(var(--hdr-h) + 16px)">
          <h3>Цена и наличие на сегодня</h3>
          <p>Позвоните или оставьте заявку. Скажем актуальную цену, посчитаем количество под объект и назовём срок отгрузки.</p>
          <ul class="chk" style="margin-bottom:1.1rem">
            <li>Счёт и накладная для организаций</li>
            <li>Самовывоз с базы на Циолковского, 1А</li>
            <li>Сертификаты по запросу</li>
          </ul>
          <a class="btn btn--fill btn--w" href="tel:{{ site.phones.sales[0].tel }}"><span>{{ site.phones.sales[0].display }}</span></a>
          <button class="btn btn--gh btn--w" type="button" data-modal style="margin-top:.5rem"><span>Написать заявку</span></button>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="sec sec--alt">
  <div class="wrap">
    <div class="head"><p class="kick">Другие направления</p><h2>Соберём в один заказ с остальным материалом</h2></div>
    <div class="tags">{% for c in catalog.categories if c.slug != cat.slug %}<a href="/stroymaterialy/{{ c.slug }}/">{{ c.name }}</a>{% endfor %}</div>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Запрос цены</p>
      <h2 style="margin-bottom:.7rem">Напишите, что нужно, и мы посчитаем</h2>
      <p class="measure-s mut">Список позиций, размеры объекта или фотография проекта. Посчитаем количество, скажем цену на сегодня и что ещё понадобится к этой позиции.</p>
    </div>
    {{ form_block('cc', 'Узнать цену и наличие', cat.name + ': скажите объём или размеры объекта, менеджер посчитает и назовёт цену на сегодня.', 'Отправить запрос', 'Каталог: ' + cat.name) }}
  </div>
</section>
{% endblock %}
