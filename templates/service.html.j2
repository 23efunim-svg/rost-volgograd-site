{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}

{% block content %}
{% set ps = svc.photos_from[0] %}
{% set ph = objects[ps].photos[2] if objects[ps].photos | length > 2 else objects[ps].photos[0] %}

<section class="hero" style="min-height:auto">
  <div class="hero__bg"><img src="/assets/photo/objects/{{ ps }}/{{ ph.name }}.webp" alt="" width="1200" height="1600" fetchpriority="high"></div>
  <div class="wrap hero__in" style="padding-block:1rem 2.4rem">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i><a href="/uslugi/">Услуги</a><i>/</i>{{ svc.nav }}</nav>
    <p class="kick">Волгоград и область</p>
    <h1 style="max-width:20ch">{{ svc.h1 }}</h1>
    <p class="hero__sub">{{ svc.lead }}</p>
    <div class="hero__act" style="margin-bottom:0">
      <button class="btn btn--fill" type="button" data-modal><span>Вызвать замерщика</span></button>
      <a class="btn btn--gh" href="tel:{{ site.phones.primary.tel }}"><span>{{ site.phones.primary.display }}</span></a>
    </div>
  </div>
</section>

<section class="sec sec--lt">
  <div class="wrap">
    <div class="head">
      <p class="kick">Состав работ</p>
      <h2>Что входит в это направление</h2>
      <p>Берём и весь список целиком, и отдельную работу из него. Если объём небольшой, скажите объект, посчитаем по факту.</p>
    </div>
    <ul class="chk chk--2">{% for w in svc.works %}<li>{{ w }}</li>{% endfor %}</ul>

    {% if svc.price_ref == 'remont' %}
    <div class="head" style="margin-top:calc(var(--sec) * .8)">
      <p class="kick">Цены</p>
      <h2>Сколько стоит за квадратный метр</h2>
      <p>{{ services.price_tables.remont.note }}</p>
    </div>
    <div class="pr-wrap">
      <table class="pr">
        <thead><tr><th scope="col">Уровень</th><th scope="col">Косметический</th><th scope="col">Новостройка</th><th scope="col">Вторичное жильё</th></tr></thead>
        <tbody>
          {% for lv in services.price_tables.remont.levels %}
          {% set rows = {} %}{% for r in lv.rows %}{% set _ = rows.update({r.label: r.price}) %}{% endfor %}
          <tr>
            <th scope="row">{{ lv.name }}</th>
            <td{% if 'Мелкий косметический ремонт' not in rows %} class="na"{% endif %}>{% if 'Мелкий косметический ремонт' in rows %}от {{ rows['Мелкий косметический ремонт'] | money }} ₽{% else %}по запросу{% endif %}</td>
            <td>от {{ rows['Новостройка'] | money }} ₽</td>
            <td>от {{ rows['Вторичное жильё'] | money }} ₽</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>
</section>

<section class="sec">
  <div class="wrap">
    <div class="head"><p class="kick">Наши объекты</p><h2>Как это выглядит в работе</h2></div>
    <div class="works">
      {% for slug in svc.photos_from[:3] %}
      {% set o = objects[slug] %}
      <a class="wk{% if loop.first %} wk--big{% endif %}" href="/raboty/{{ slug }}/">
        <img src="/assets/photo/objects/{{ slug }}/{{ o.photos[1].name }}{% if not loop.first %}-thumb{% endif %}.webp" alt="{{ o.title }}" loading="lazy" width="720" height="960">
        <span class="wk__i">{{ '%02d' % loop.index }}</span>
        <span class="wk__m"><b>{{ o.title }}</b><span>{{ objects_meta.objects[slug].type }}</span></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--alt">
  <div class="wrap">
    <div class="head">
      <p class="kick">Материалы</p>
      <h2>Материал на эту работу можно взять у нас же</h2>
      <p>Считаем количество под объект и собираем комплект целиком. Цену и наличие называем на день обращения: металл, кабель и смеси переоцениваются каждую неделю.</p>
    </div>
    <div class="tags">{% for c in catalog.categories %}<a href="/stroymaterialy/{{ c.slug }}/">{{ c.name }}</a>{% endfor %}</div>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Следующий шаг</p>
      <h2 style="margin-bottom:.7rem">Посчитаем ваш объект</h2>
      <p class="measure-s mut" style="margin-bottom:1.4rem">Оставьте телефон, менеджер уточнит детали и договорится о замере. Консультация бесплатная.</p>
      <ul class="chk">{% for g in site.guarantees %}<li>{{ g }}</li>{% endfor %}</ul>
    </div>
    {{ form_block('s', 'Заявка на ' + svc.nav | lower, 'Скажите объект и объём, менеджер посчитает и назовёт вилку до выезда.', 'Отправить заявку', svc.nav) }}
  </div>
</section>
{% endblock %}
