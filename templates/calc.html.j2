{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}

{% block content %}
<section class="sec pgh" style="padding-bottom:calc(var(--sec) * .5)">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i><a href="/spravochnik/">Справочник</a><i>/</i>{{ calc.name }}</nav>
    <h1>{{ calc.h1 }}</h1>
    <p>{{ calc.lead }}</p>
  </div>
</section>

<section class="sec sec--alt" id="raschet" style="padding-top:calc(var(--sec) * .7)">
  <div class="wrap">
    <div class="calc" data-calc="{{ calc.slug }}">
      <div>
        {% for f in calc.fields %}
        <div class="cf">
          <label class="cf__l" for="f-{{ f.id }}">{{ f.label }}</label>
          <input id="f-{{ f.id }}" data-cf="{{ f.id }}" class="num-in" type="number" inputmode="decimal"
                 value="{{ f.value }}" min="{{ f.min }}" max="{{ f.max }}" step="{{ f.step }}">
          {% if f.hint %}<p class="res__n" style="margin-top:.4rem">{{ f.hint }}</p>{% endif %}
        </div>
        {% endfor %}
      </div>

      <div class="res">
        <span class="res__k">{{ calc.result_label }}</span>
        <div class="res__v" data-cres>—</div>
        <div class="res__s" data-cres2></div>
        <button class="btn btn--fill btn--w" type="button" data-modal><span>Узнать цену и наличие</span></button>
        <p class="res__n">{{ calc.formula_note }}</p>
      </div>
    </div>
  </div>
</section>

<section class="sec sec--lt">
  <div class="wrap prose">
    <h2 style="margin-top:0">{{ calc.article_h2 }}</h2>
    {% for p in calc.article %}<p>{{ p }}</p>{% endfor %}

    <h3>Формула, по которой считает калькулятор</h3>
    <p style="font-family:ui-monospace,Consolas,monospace;border-left:2px solid var(--brass);padding:.6rem 0 .6rem .9rem;font-size:var(--sm)">{{ calc.formula }}</p>
    <p class="mut" style="font-size:var(--sm)">{{ calc.formula_note }}</p>
  </div>
</section>

<section class="sec sec--alt">
  <div class="wrap">
    <div class="head"><p class="kick">Другие расчёты</p><h2>Посчитать что-то ещё</h2></div>
    <div class="tags">
      {% for c in calcs if c.slug != calc.slug %}<a href="/spravochnik/{{ c.slug }}/">{{ c.name }}</a>{% endfor %}
      <a href="/stroymaterialy/">Каталог материалов</a>
    </div>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Материалы</p>
      <h2 style="margin-bottom:.7rem">Посчитаем комплект и назовём цену на сегодня</h2>
      <p class="measure-s mut">Скажите объём из расчёта, менеджер проверит цифры, подберёт позиции и скажет, что ещё понадобится.</p>
    </div>
    {{ form_block('cl', 'Узнать цену и наличие', 'Напишите объём из расчёта и объект. Ответим ценой и наличием на день обращения.', 'Отправить запрос', 'Калькулятор: ' + calc.name) }}
  </div>
</section>
{% endblock %}
