{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}

{% block content %}
<section class="sec pgh" style="padding-bottom:calc(var(--sec) * .5)">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i>Работы</nav>
    <p class="kick">Волгоград и область</p>
    <h1>Объекты, снятые на наших площадках</h1>
    <p>Здесь и готовые интерьеры, и черновые этапы: разводка электрики по перекрытию, шумоизоляция, штукатурка по маякам. По таким кадрам видно то, что после отделки уже не покажешь.</p>
  </div>
</section>

<section class="sec" style="padding-top:calc(var(--sec) * .6)">
  <div class="wrap">
    <div class="works">
      {% set mods = ['big','','','tall','','','','big','',''] %}
      {% for slug, o in objects.items() %}
      {% set mod = mods[loop.index0] if loop.index0 < mods | length else '' %}
      <a class="wk{% if mod %} wk--{{ mod }}{% endif %}" href="/raboty/{{ slug }}/">
        <img src="/assets/photo/objects/{{ slug }}/{{ o.photos[0].name }}{% if mod != 'big' %}-thumb{% endif %}.webp" alt="{{ o.title }}" loading="lazy" width="720" height="960">
        <span class="wk__i">{{ '%02d' % loop.index }}</span>
        <span class="wk__m"><b>{{ o.title }}</b><span>{{ objects_meta.objects[slug].type }}, {{ o.photos | length }} фото</span></span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--lt">
  <div class="wrap">
    <div class="head"><p class="kick">Про фотографии</p><h2>Все снимки сделаны на объектах компании</h2></div>
    <p class="measure">Фотографии не студийные: снято в процессе работы и после сдачи. Кадры с чернового этапа оставлены намеренно, потому что качество ремонта определяется тем, что спрятано под отделкой.</p>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Следующий шаг</p>
      <h2 style="margin-bottom:.7rem">Покажем объекты вживую</h2>
      <p class="measure-s mut">Если нужно посмотреть работу не по фото, скажите на замере. Договоримся с заказчиком и покажем объект, который сейчас в работе.</p>
    </div>
    {{ form_block('w', 'Вызвать замерщика', 'Оставьте телефон, менеджер перезвонит в рабочее время и договорится об удобном времени замера.', 'Вызвать замерщика', 'Портфолио') }}
  </div>
</section>
{% endblock %}
