{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}
{% from "_icons.html.j2" import ic %}
{% set h = content.home %}

{% block content %}

<!-- первый экран: слева оффер, справа квиз с живым расчётом -->
<section class="hero">
  <div class="hero__bg">
    <img src="/assets/photo/objects/simonova/simonova-08.webp"
         alt="Квартира после ремонта, выполненного компанией РОСТ в Волгограде"
         width="1200" height="1600" fetchpriority="high">
    <video class="hero__vid" data-hero-video="/assets/video/hero.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
  </div>
  <div class="wrap hero__in">

    <div>
      <div class="badges">
        <i>Волгоград, <b>с 2000 года</b></i>
        <i>Гарантия на работы <b>12 месяцев</b></i>
        <i><b>291 объект</b> за 4 года</i>
        <i>Своя база на <b>Циолковского, 1А</b></i>
      </div>
      <h1>{{ h.hero.h1_a }} <em>{{ h.hero.h1_b }}</em></h1>
      <p class="hero__sub">{{ h.hero.lead }}</p>
      <div class="hero__act">
        <button class="btn btn--fill" type="button" data-modal><span>Вызвать замерщика</span></button>
        <a class="btn btn--gh" href="/raboty/"><span>Смотреть работы</span></a>
      </div>
    </div>

    <form class="frm quiz" method="post" action="/api/lead.php" data-lead novalidate>
      <h2>Посчитайте ремонт за минуту</h2>
      <p class="quiz__sub">Считаем по нашему прайсу, цифру видно сразу.</p>

      <input type="hidden" name="source" value="Квиз на первом экране">
      <input type="hidden" name="page" value="" data-page>
      <input type="hidden" name="ts" value="" data-ts>
      <input type="hidden" name="utm" value="" data-utm>
      <input type="hidden" name="note" value="" data-quiz-note>
      <div class="hp" aria-hidden="true"><label>Не заполняйте это поле<input type="text" name="company" tabindex="-1" autocomplete="off"></label></div>

      <div class="quiz__q">
        <span><b>1.</b> Что за объект</span>
        <div class="opt" role="radiogroup" aria-label="Тип объекта">
          <label><input type="radio" name="obj" value="new" checked><span>Новостройка</span></label>
          <label><input type="radio" name="obj" value="old"><span>Вторичка</span></label>
          <label><input type="radio" name="obj" value="cosm"><span>Косметика</span></label>
        </div>
      </div>

      <div class="quiz__q">
        <span><b>2.</b> Уровень отделки</span>
        <div class="opt" role="radiogroup" aria-label="Уровень отделки">
          <label><input type="radio" name="lvl" value="econom" checked><span>Эконом</span></label>
          <label><input type="radio" name="lvl" value="standart"><span>Стандарт</span></label>
          <label><input type="radio" name="lvl" value="elit"><span>Элит</span></label>
        </div>
      </div>

      <div class="quiz__q">
        <span><b>3.</b> Площадь помещения</span>
        <div class="rng">
          <input type="range" id="calc-area" min="18" max="220" step="1" value="55" aria-label="Площадь в квадратных метрах">
          <b data-calc-area>55 м²</b>
        </div>
      </div>

      <div class="quiz__out">
        <span>Ориентировочно<br><i style="font-style:normal" data-calc-rate>по ставке 10 000 ₽ за м²</i></span>
        <b data-calc-sum>от 550 000 ₽</b>
      </div>

      <div class="fld" data-fld>
        <input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="Телефон для точного расчёта" required aria-label="Телефон">
        <span class="fld__e">Проверьте номер: нужно 11 цифр, начиная с 7 или 8</span>
      </div>

      <label class="cns">
        <input type="checkbox" name="consent" value="1" required>
        <span>Даю <a href="/soglasie/" target="_blank">согласие на обработку данных</a></span>
      </label>

      <button class="btn btn--fill btn--w" type="submit"><span>Получить точный расчёт</span></button>
      <div class="msg" data-msg role="status"></div>
      <p class="quiz__note" data-calc-note>Ориентир, а не смета: точная сумма после осмотра объекта.</p>
    </form>

  </div>
</section>

<div class="tick" aria-hidden="true">
  <div class="tick__t">{% for i in range(2) %}{% for t in h.ticker %}<span>{{ t }}</span>{% endfor %}{% endfor %}</div>
</div>

<!-- лента доверия -->
<div class="wrap">
  <div class="trust">
    <span>{{ ic('doc') }} Договор, акты и чеки</span>
    <span>{{ ic('shield') }} Гарантия 12 месяцев</span>
    <span>{{ ic('wallet') }} Смета до начала работ</span>
    <span>{{ ic('truck') }} Материалы со своей базы</span>
    <span>{{ ic('star') }} 128 отзывов на Авито, оценка 5,0</span>
  </div>
</div>

<!-- два направления: широкие полосы -->
<section class="sec">
  <div class="wrap">
    <div class="head">
      <p class="kick">{{ h.duo.eyebrow }}</p>
      <h2>{{ h.duo.h2 }}</h2>
      <p>{{ h.duo.lead }}</p>
    </div>
  </div>
  <div class="wrap">
    <div class="dir">
      {% set dimg = ['/assets/photo/objects/arbat/arbat-06.webp', '/assets/photo/objects/yantarnaya/yantarnaya-11.webp'] %}
      {% for c in h.duo.cards %}
      <a class="dir__i rv" href="{{ c.url }}">
        {% if loop.index0 == 0 %}
        <div class="dir__ph"><img data-prlx="0.05" src="{{ dimg[0] }}" alt="" loading="lazy" width="1200" height="1600"></div>
        <div class="dir__tx">
          <span class="dir__n">{{ c.num }}</span>
          <h3>{{ c.title }}</h3>
          <p>{{ c.text }}</p>
          <div class="dir__l">{% for t in c.tags %}<i>{{ t }}</i>{% endfor %}</div>
          <span class="lnk">{{ c.cta }}</span>
        </div>
        {% else %}
        <div class="dir__tx" style="order:-1">
          <span class="dir__n">{{ c.num }}</span>
          <h3>{{ c.title }}</h3>
          <p>{{ c.text }}</p>
          <div class="dir__l">{% for t in c.tags %}<i>{{ t }}</i>{% endfor %}</div>
          <span class="lnk">{{ c.cta }}</span>
        </div>
        <div class="dir__ph"><img data-prlx="0.05" src="{{ dimg[1] }}" alt="" loading="lazy" width="1200" height="1600"></div>
        {% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- цифры -->
<section class="sec sec--alt">
  <div class="wrap">
    <div class="head"><p class="kick">{{ h.nums.eyebrow }}</p><h2>{{ h.nums.h2 }}</h2></div>
    <div class="nums">
      {% for n in h.nums['items'] %}
      <div><b{% if n.count %} data-count="{{ n.count }}" data-pre="{{ n.pre|default('') }}" data-suf="{{ n.suf|default('') }}"{% endif %}>{{ n.b }}</b><span>{{ n.s }}</span><small>{{ n.note }}</small></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- услуги: плотный перечень -->
<section class="sec sec--lt" id="uslugi">
  <div class="wrap">
    <div class="head">
      <p class="kick">Что делаем</p>
      <h2>Берём и весь объект целиком, и отдельную работу</h2>
      <p>Дом с нуля, ремонт квартиры, замена проводки или один санузел. Материалы идут со своей базы.</p>
    </div>
    <div class="svc">
      {% for s in services.services %}
      <a href="/uslugi/{{ s.slug }}/">
        <span class="svc__n">{{ '%02d' % loop.index }}</span>
        <span class="svc__ic">{{ ic(svc_icons[s.slug]) }}</span>
        <span class="svc__t">{{ s.nav }}<s>{{ s.works[:3] | join(', ') | lower }}</s></span>
        <span class="svc__p">{% if s.price_ref == 'remont' %}от 7 000 ₽/м²{% else %}цена после замера{% endif %}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- работы: мозаика -->
<section class="sec">
  <div class="wrap">
    <div class="head">
      <p class="kick">Выполненные работы</p>
      <h2>Объекты, которые можно рассмотреть вблизи</h2>
      <p>Съёмка на наших объектах в Волгограде и области. Есть и готовые интерьеры, и черновые этапы: по ним видно то, что после отделки уже не покажешь.</p>
    </div>
    <div class="works">
      {% set feat = [('arbat','big'), ('partizanskaya',''), ('yantarnaya',''), ('simonova','tall'), ('barminy',''), ('kim',''), ('nevskaya',''), ('borby','')] %}
      {% for slug, mod in feat %}
      {% set o = objects[slug] %}
      <a class="wk{% if mod %} wk--{{ mod }}{% endif %}" href="/raboty/{{ slug }}/">
        <img src="/assets/photo/objects/{{ slug }}/{{ o.photos[0].name }}{% if mod != 'big' %}-thumb{% endif %}.webp" alt="{{ o.title }}" loading="lazy" width="720" height="960">
        <span class="wk__i">{{ '%02d' % loop.index }}</span>
        <span class="wk__m"><b>{{ o.title }}</b><span>{{ objects_meta.objects[slug].type }}, {{ o.photos | length }} фото</span></span>
      </a>
      {% endfor %}
    </div>
    <p style="margin-top:1.3rem"><a class="btn btn--gh" href="/raboty/"><span>Все объекты</span></a></p>
  </div>
</section>

<!-- цены таблицей -->
<section class="sec sec--lt" id="ceny">
  <div class="wrap">
    <div class="head">
      <p class="kick">Цены на ремонт</p>
      <h2>Три уровня отделки, ставка за квадратный метр</h2>
      <p>{{ services.price_tables.remont.note }}</p>
    </div>
    <div class="pr-wrap">
      <table class="pr">
        <thead>
          <tr><th scope="col">Уровень</th><th scope="col">Косметический</th><th scope="col">Новостройка</th><th scope="col">Вторичное жильё</th></tr>
        </thead>
        <tbody>
          {% for lv in services.price_tables.remont.levels %}
          <tr>
            <th scope="row">{{ lv.name }}<span class="pr__lvl">{{ lv.desc }}</span></th>
            {% set rows = {} %}
            {% for r in lv.rows %}{% set _ = rows.update({r.label: r.price}) %}{% endfor %}
            <td{% if 'Мелкий косметический ремонт' not in rows %} class="na"{% endif %}>{% if 'Мелкий косметический ремонт' in rows %}от {{ rows['Мелкий косметический ремонт'] | money }} ₽{% else %}по запросу{% endif %}</td>
            <td>от {{ rows['Новостройка'] | money }} ₽</td>
            <td>от {{ rows['Вторичное жильё'] | money }} ₽</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <p class="mut" style="margin-top:1rem;font-size:var(--sm)">По направлениям без ставки за метр считаем по объёму: количество точек, погонные метры, квадратура кровли или забора. <a href="/ceny/" style="border-bottom:1px solid var(--brass);color:var(--brass)">Подробно о ценах</a></p>
  </div>
</section>

<!-- отстройка -->
<section class="sec sec--lt" style="padding-top:0">
  <div class="wrap">
    <div class="head">
      <p class="kick">{{ h.vs.eyebrow }}</p>
      <h2>{{ h.vs.h2 }}</h2>
      <p>{{ h.vs.lead }}</p>
    </div>
    <div class="vs">
      {% for r in h.vs.rows %}
      <div class="vs__r">
        <div class="vs__c"><b>Как бывает</b><p>{{ r.bad }}</p></div>
        <div class="vs__c"><b>Как у нас</b><p>{{ r.good }}</p></div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- материалы -->
<section class="sec">
  <div class="wrap">
    <div class="head">
      <p class="kick">Стройматериалы</p>
      <h2>{{ catalog.intro.h1 }}</h2>
      <p>{{ catalog.intro.lead }}</p>
    </div>
  </div>
  <div class="wrap">
    <div class="cat">
      {% for c in catalog.categories[:8] %}
      <a href="/stroymaterialy/{{ c.slug }}/">
        <span class="cat__b">{{ '%02d' % loop.index }}</span>
        {{ ic(c.icon, 'ic--l') }}
        <h3>{{ c.name }}</h3>
        <ul>{% for i in c['items'][:4] %}<li>{{ i }}</li>{% endfor %}</ul>
        <span class="lnk">Цена и наличие</span>
      </a>
      {% endfor %}
    </div>
  </div>
  <div class="wrap" style="margin-top:1.3rem">
    <a class="btn btn--gh" href="/stroymaterialy/"><span>Все 12 направлений</span></a>
  </div>
</section>

<!-- почему так, с иконками -->
<section class="sec">
  <div class="wrap">
    <div class="head">
      <p class="kick">Как это устроено</p>
      <h2>Шесть вещей, из которых складывается результат</h2>
      <p>Ничего необычного: просто каждая из них записана в договор или проверяется до начала работ.</p>
    </div>
  </div>
  <div class="wrap">
    <div class="adv">
      <div class="rv">{{ ic('ruler') }}<div><h3>Замер и смета до старта</h3><p>Приезжаем, снимаем размеры, смотрим коммуникации. Цену по каждой позиции вы видите до начала работ.</p></div></div>
      <div class="rv">{{ ic('doc') }}<div><h3>Договор с составом работ</h3><p>Что делаем, в какой срок и за какие деньги. Работы сверх сметы согласуются отдельно.</p></div></div>
      <div class="rv">{{ ic('shield') }}<div><h3>Гарантия 12 месяцев</h3><p>Срок записан в договоре, а не сказан на словах. Сертификаты на материалы передаём вместе с актами.</p></div></div>
      <div class="rv">{{ ic('truck') }}<div><h3>Материалы со своей базы</h3><p>Считаем количество под объект, везём с Циолковского. Работа не встаёт в ожидании поставки.</p></div></div>
      <div class="rv">{{ ic('wallet') }}<div><h3>Работа с организациями</h3><p>Счёт, безнал, накладная и закрывающие документы. Реквизиты ИП открыты на сайте.</p></div></div>
      <div class="rv">{{ ic('pin') }}<div><h3>Волгоград и область</h3><p>Компания работает с 2000 года, база и офис на Циолковского, 1А. Приезжайте посмотреть материал.</p></div></div>
    </div>
  </div>
</section>

<!-- этапы -->
<section class="sec sec--alt">
  <div class="wrap">
    <div class="head"><p class="kick">Как проходит работа</p><h2>Пять шагов от звонка до подписанного акта</h2></div>
    <div class="stp">
      {% for st in site.process %}
      <div><b>{{ '%02d' % st.step }}</b><h3>{{ st.title }}</h3><p>{{ st.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- отзывы -->
<section class="sec sec--lt">
  <div class="wrap">
    <div class="head">
      <p class="kick">{{ h.quotes.eyebrow }}</p>
      <h2>{{ h.quotes.h2 }}</h2>
      <p>{{ h.quotes.lead }}</p>
    </div>
    <div class="qt">
      {% for q in h.quotes['items'] %}
      <div><p>{{ q.text }}</p><cite>{{ q.cite }}</cite></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="sec sec--alt">
  <div class="wrap">
    <div class="head"><p class="kick">Частые вопросы</p><h2>Что спрашивают до начала работ</h2></div>
    <div class="faq">
      {% for f in h.faq %}
      <details{% if loop.first %} open{% endif %}>
        <summary>{{ f.q }}</summary>
        <div class="faq__a">{{ f.a }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<!-- заявка -->
<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Следующий шаг</p>
      <h2 style="margin-bottom:.7rem">{{ h.cta.h2 }}</h2>
      <p class="measure-s mut" style="margin-bottom:1.4rem">{{ h.cta.lead }}</p>
      <ul class="chk">{% for g in site.guarantees %}<li>{{ g }}</li>{% endfor %}</ul>
    </div>
    {{ form_block('main', 'Вызвать замерщика', 'Приедем, снимем размеры, посмотрим состояние коммуникаций и посчитаем смету по вашему объекту.', 'Вызвать замерщика', 'Главная, нижняя форма') }}
  </div>
</section>

{% endblock %}
