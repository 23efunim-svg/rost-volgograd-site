{% extends "base.html.j2" %}
{% from "_macros.html.j2" import form_block %}
{% set h = content.home %}

{% block content %}
<section class="sec pgh" style="padding-bottom:calc(var(--sec) * .5)">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Главная</a><i>/</i>О компании</nav>
    <p class="kick">Волгоград, с 2000 года</p>
    <h1>Работаем в Волгограде двадцать шесть лет и держим склад вместе с бригадами</h1>
    <p>РЕМОПТСТРОЙТОРГ делает строительно-ремонтные работы и продаёт стройматериалы. Обычно это два разных бизнеса и два разных счёта. У нас это одна компания, поэтому объём материала считается сразу под объект.</p>
  </div>
</section>

<section class="sec" style="padding-top:calc(var(--sec) * .5)">
  <div class="wrap">
    <div class="nums">
      {% for n in h.nums['items'] %}
      <div><b>{{ n.b }}</b><span>{{ n.s }}</span><small>{{ n.note }}</small></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--lt">
  <div class="wrap">
    <div class="grid" style="grid-template-columns:1.25fr .75fr;gap:clamp(1.4rem,1rem+2.4vw,3rem);align-items:start">
      <div class="prose">
        <p class="kick">Чем занимаемся</p>
        <h2 style="margin-top:0">Два направления, которые усиливают друг друга</h2>
        <p>Первое направление, строительство и ремонт: дом с нуля, ремонт квартиры, коммерческое помещение, инженерные сети, кровля, забор и участок. Второе, продажа стройматериалов: электрика, сантехника, кровля, металлопрокат, утеплители, сухие смеси, отделка.</p>
        <p>Материалы можно купить отдельно, без работ. Ремонт можно заказать отдельно, со своим материалом. Чаще берут вместе: тогда количество считается под конкретный объект, а не по средним нормам.</p>

        <h2>Как мы работаем с деньгами</h2>
        <p>Смета составляется до начала работ, вместе с ценами по каждой позиции. Скрытых платежей в ней нет, это правило компании с самого начала. Для организаций выставляем счёт и работаем по безналу.</p>

        <h2>Что остаётся у заказчика после сдачи</h2>
        <ul>{% for g in site.guarantees %}<li>{{ g }}</li>{% endfor %}</ul>

        <h2>Где мы находимся</h2>
        <p>База и офис: {{ site.office.address }}. {{ site.office.how_to_find }}. Работаем по Волгограду и Волгоградской области.</p>
      </div>

      <aside>
        <div class="frm">
          <h3>Реквизиты</h3>
          <p>Проверить, кому вы платите, можно до подписания договора.</p>
          <ul class="chk">
            <li>{{ site.legal.name }}</li>
            <li>ОГРНИП {{ site.legal.ogrnip }}</li>
            <li>ИНН {{ site.legal.inn }}</li>
            <li>{{ site.legal.address_legal }}</li>
            <li>{{ site.legal.bank }}</li>
          </ul>
          <a class="btn btn--gh btn--w" href="/kontakty/" style="margin-top:1.1rem"><span>Все контакты и схема проезда</span></a>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="sec sec--alt">
  <div class="wrap">
    <div class="head"><p class="kick">Как проходит работа</p><h2>Пять шагов от звонка до подписанного акта</h2></div>
    <div class="stp">
      {% for st in site.process %}
      <div><b>{{ '%02d' % st.step }}</b><h3>{{ st.title }}</h3><p>{{ st.text }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="sec sec--lt">
  <div class="wrap">
    <div class="head">
      <p class="kick">{{ h.quotes.eyebrow }}</p>
      <h2>{{ h.quotes.h2 }}</h2>
      <p>{{ h.quotes.lead }}</p>
    </div>
    <div class="qt">
      {% for q in h.quotes['items'] %}<div><p>{{ q.text }}</p><cite>{{ q.cite }}</cite></div>{% endfor %}
    </div>
  </div>
</section>

<section class="sec" id="zayavka">
  <div class="wrap band">
    <div>
      <p class="kick">Следующий шаг</p>
      <h2 style="margin-bottom:.7rem">{{ h.cta.h2 }}</h2>
      <p class="measure-s mut">{{ h.cta.lead }}</p>
    </div>
    {{ form_block('a', 'Вызвать замерщика', 'Оставьте телефон, менеджер перезвонит в рабочее время и договорится об удобном времени.', 'Вызвать замерщика', 'О компании') }}
  </div>
</section>
{% endblock %}
