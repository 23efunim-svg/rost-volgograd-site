{% extends "base.html.j2" %}

{% block head_extra %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
<section class="sec" style="min-height:58vh;display:grid;align-items:center">
  <div class="wrap">
    <p class="kick">404</p>
    <h1 style="margin-bottom:.8rem">Такой страницы на сайте нет</h1>
    
    <p class="measure mut" style="margin-bottom:1.4rem">Возможно, адрес набран с опечаткой или страницу перенесли. Начните с главной или сразу перейдите к нужному разделу.</p>
    <div class="hero__act">
      <a class="btn btn--fill" href="/"><span>На главную</span></a>
      <a class="btn btn--gh" href="/uslugi/"><span>Услуги</span></a>
      <a class="btn btn--gh" href="/stroymaterialy/"><span>Стройматериалы</span></a>
    </div>
    <p class="mut" style="margin-top:2.5rem">Или позвоните: <a href="tel:{{ site.phones.primary.tel }}" class="brass">{{ site.phones.primary.display }}</a></p>
  </div>
</section>
{% endblock %}
